# Database
DATABASE_URL=postgresql://viralflow:viralflow_dev_password@localhost:5432/viralflow
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=viralflow-videos
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/viralflow-queue

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Video Processing
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=60
SUPPORTED_VIDEO_FORMATS=mp4,webm,mov

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
CLIP_API_ENDPOINT=http://localhost:8000
WHISPER_API_ENDPOINT=http://localhost:8001

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sentry (Error tracking)
SENTRY_DSN=

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_ANALYTICS=true
